# Chế độ database mặc định: firebase | gas | mock
# (Để trống sẽ tự ưu tiên firebase nếu đã cấu hình, sau đó đến gas, cuối cùng mock)
VITE_DB_PROVIDER=firebase

# URL Google Apps Script Web App sau khi Deploy (kết thúc bằng /exec)
# Dùng cho chế độ GAS, Sync 2 chiều với Google Sheet, và Proxy quét hóa đơn AI + lưu Google Drive
VITE_GAS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google OAuth 2.0 Client ID (dùng cho GIS khi chạy chế độ GAS thuần chưa bật Firebase)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Cấu hình Firebase Web App (Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Bật chế độ Mock Data cục bộ (true = luôn dùng mock)
VITE_USE_MOCK=true
